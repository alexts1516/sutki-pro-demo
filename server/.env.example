# ================================================================
#  Настройки сервера. Скопируйте этот файл в .env и поменяйте значения.
#  Файл .env НЕ попадает в git (там будут секреты).
# ================================================================

# --- Основное ---
PORT=3000
# Адрес, по которому сервер доступен снаружи (нужен для ссылок и вебхуков оплаты)
PUBLIC_URL=http://localhost:3000
# База данных. SQLite — просто файл рядом со схемой. Для PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/astana?schema=public"
DATABASE_URL="file:./dev.db"
# Секрет для входа (подпись токенов). Любая длинная случайная строка, минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Аккаунт по умолчанию для сайта гостей (slug из таблицы Account)
DEFAULT_ACCOUNT_SLUG=astana-stay
# С каких сайтов разрешены запросы к API (через запятую). Для GitHub Pages:
CORS_ORIGINS=https://alexts1516.github.io,http://localhost:8765

# --- Загрузка фото ---
# local — папка server/uploads (по умолчанию); s3 — S3-совместимое облако (Amazon S3, Cloudflare R2, Yandex Object Storage, MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Только для STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=us-east-1
# Адрес API хранилища; пусто — Amazon S3. Примеры: https://<id>.r2.cloudflarestorage.com, https://storage.yandexcloud.net
S3_ENDPOINT=
# Публичный адрес файлов (CDN или публичный бакет); пусто — <endpoint>/<bucket>
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true — адреса вида endpoint/bucket/ключ (MinIO, R2); false — bucket.endpoint/ключ
S3_FORCE_PATH_STYLE=true

# --- Telegram-бот (необязательно) ---
# Пусто — бот выключен, уведомления пишутся в консоль и в журнал NotificationLog.
# Токен выдаёт @BotFather (инструкция в README_SERVER.md).
TELEGRAM_BOT_TOKEN=
# Имя бота без @, для ссылок t.me/<имя>?start=...
TELEGRAM_BOT_USERNAME=
# Как получать сообщения от Telegram: polling (проще, для начала) или webhook (для хостинга)
TELEGRAM_MODE=polling

# --- Онлайн-оплата (необязательно) ---
# Пусто — оплата картой выключена, гостю показываются оффлайн-способы.
# cloudpayments | paylink
PAYMENTS_PROVIDER=
# CloudPayments: Public ID (publicTerminalId) и API Secret из личного кабинета
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
# PayLink (paylink.kz): ID магазина, секретный ключ и публичный ключ для проверки подписи
PAYLINK_SHOP_ID=
PAYLINK_SECRET_KEY=
PAYLINK_PUBLIC_KEY=
PAYLINK_TEST_MODE=true

# Трансферы «как в Uber»: эскалация «никто не взял» и напоминание водителю
TRANSFER_OFFER_TIMEOUT_MIN=30
TRANSFER_ESCALATE_BEFORE_HOURS=3
TRANSFER_REMINDER_BEFORE_MIN=120
# Комиссия с трансферов задаётся в админке: «Настройки» (по умолчанию водитель получает 100%).

# --- Слежение за рейсами (необязательно) ---
# Ключ AeroDataBox (RapidAPI). Пусто — слежение выключено, время подачи меняют вручную.
AERODATABOX_API_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# --- Защита от перебора ---
# Неудачных входов на один логин с одного IP за окно / всего неудачных входов с одного IP
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
AUTH_IP_MAX=30
# Ссылки без входа (/link/...): запросов с одного IP за окно / запросов с неверной ссылкой
LINK_RATE_MAX=120
LINK_BAD_MAX=20
LINK_WINDOW_MIN=15
# TRANSFER_EXTERNAL_DRIVERS=1   # внешние водители (таксопарки) — по умолчанию выключено
