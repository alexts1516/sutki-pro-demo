{
  "name": "astana-stay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Серверная версия Сутки·Pro (клиент — The Address · Apart Hotel): API, админка владельца, Telegram-уведомления, платежи",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && node prisma/seed.js",
    "db:studio": "prisma studio",
    "setup": "node scripts/setup.js",
    "test": "node scripts/test-db.js && node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.0"
  }
}
