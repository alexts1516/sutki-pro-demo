// =====================================================================
//  Схема базы данных Сутки·Pro (демо-клиент — The Address · Apart Hotel) (Prisma ORM)
//  Сейчас — SQLite (один файл dev.db, ничего устанавливать не нужно).
//  Переход на PostgreSQL: поменять provider = "postgresql" и DATABASE_URL,
//  затем `npx prisma migrate dev` (подробно — в README_SERVER.md).
//
//  Правило мультиаккаунтности: почти у каждой таблицы есть accountId —
//  это «арендный бизнес» (владелец со своей командой и квартирами).
//  Все запросы в API фильтруются по accountId текущего пользователя.
//  Значения-«перечисления» хранятся строками (список допустимых — в комментарии).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Аккаунт = один арендный бизнес (владелец). Поля тарифа — заготовка под биллинг.
model Account {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique /// адрес сайта для гостей: /api/public/<slug>/...
  plan        String    @default("trial") /// trial | start | pro
  status      String    @default("active") /// active | past_due | suspended | cancelled
  trialEndsAt DateTime?
  billingEmail String?
  timezone    String    @default("Asia/Almaty")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships   Membership[]
  invites       Invite[]
  guests        Guest[]
  apartments    Apartment[]
  photos        ApartmentPhoto[]
  bookings      Booking[]
  transfers     Transfer[]
  cleaningTasks CleaningTask[]
  repairTasks   RepairTask[]
  estimates     RepairEstimate[]
  contractors   Contractor[]
  rates         ExchangeRate[]
  currency      CurrencySettings?
  siteTexts     SiteText[]
  brand         Brand?
  notifications NotificationLog[]
  payments      Payment[]
}

/// Сотрудник или владелец (гости — отдельная таблица Guest). Один человек может состоять в нескольких аккаунтах.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  name         String
  passwordHash String
  telegramId   String?  @unique /// chat id в Telegram после привязки через /start <код>
  locale       String   @default("ru") /// ru | en
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  cleaningTasks CleaningTask[] @relation("CleaningAssignee")
  repairTasks   RepairTask[]   @relation("RepairAssignee")
  invites       Invite[]
}

/// Роль пользователя в конкретном аккаунте.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      String /// owner | admin | cleaning | master
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

/// Одноразовый код для привязки Telegram сотрудника: t.me/<бот>?start=i_<code>
model Invite {
  id        String    @id @default(cuid())
  accountId String
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Гость (не сотрудник). Telegram привязывается по ссылке из подтверждения брони.
model Guest {
  id             String   @id @default(cuid())
  accountId      String
  name           String
  phone          String?
  email          String?
  telegramChatId String?
  locale         String   @default("ru")
  createdAt      DateTime @default(now())

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  transfers Transfer[]

  @@index([accountId])
}

model Apartment {
  id           String   @id @default(cuid())
  accountId    String
  code         String? /// короткий номер для людей, например «45»
  title        String
  titleEn      String?
  complex      String?
  address      String
  district     String
  rooms        String /// «Студия», «1-комн.», «2-комн.», «3-комн.»
  maxGuests    Int
  areaM2       Int?
  basePriceKzt Int
  description  String?
  descriptionEn String?
  petsAllowed  Boolean  @default(false)
  petFeeKzt    Int      @default(0)
  petNote      String?
  // доступ в квартиру — видят только владелец, админ и назначенный исполнитель
  lockCode     String?
  keyboxCode   String?
  intercom     String?
  entrance     String?
  floor        Int?
  wifiName     String?
  wifiPassword String?
  accessNote   String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  photos        ApartmentPhoto[]
  bookings      Booking[]
  cleaningTasks CleaningTask[]
  repairTasks   RepairTask[]
  transfers     Transfer[]

  @@index([accountId])
}

/// Фото квартиры — без ограничения по количеству; подпись («Вид», «Кухня», «Ванная»…), порядок, обложка.
model ApartmentPhoto {
  id          String   @id @default(cuid())
  accountId   String
  apartmentId String
  url         String /// публичный адрес картинки
  storageKey  String /// ключ в хранилище (локальная папка uploads или S3)
  caption     String   @default("")
  captionEn   String   @default("")
  sortOrder   Int      @default(0)
  isCover     Boolean  @default(false)
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime @default(now())

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([apartmentId, sortOrder])
}

model Booking {
  id            String    @id @default(cuid())
  accountId     String
  apartmentId   String
  guestId       String?
  number        Int /// номер брони для людей (1040, 1041…), уникален в аккаунте
  token         String    @unique /// секрет для ссылки гостя: t.me/<бот>?start=b_<token>
  source        String /// site | airbnb | booking | telegram | whatsapp | direct
  status        String    @default("request") /// request | confirmed | cancelled | completed
  checkIn       DateTime /// дата заезда (00:00 UTC этого дня)
  checkOut      DateTime /// дата выезда
  checkInTime   String    @default("14:00")
  checkOutTime  String    @default("12:00")
  guestsCount   Int
  nightlyKzt    Int
  totalKzt      Int
  currencyShown String    @default("KZT") /// валюта, в которой гость видел цену: KZT | RUB | USD | EUR
  amountShown   Float? /// сумма в этой валюте на момент заявки
  paymentMethod String? /// card | cash | kaspi | telegram | transfer
  paymentStatus String    @default("unpaid") /// unpaid | prepaid | paid | refunded
  pets          Boolean   @default(false)
  petFeeKzt     Int       @default(0)
  note          String?
  cleanerName   String? /// кто уберёт после выезда (демо-данные)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account   Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apartment Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  guest     Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  transfers Transfer[]
  cleanings CleaningTask[]
  payments  Payment[]

  @@unique([accountId, number])
  @@index([accountId, checkIn])
  @@index([apartmentId, checkIn])
}

model Transfer {
  id          String   @id @default(cuid())
  accountId   String
  bookingId   String?
  guestId     String?
  apartmentId String?
  direction   String /// in (встреча) | out (проводы)
  place       String   @default("airport") /// airport | station
  date        DateTime
  time        String
  flight      String?
  pax         Int      @default(1)
  bags        Int      @default(1)
  childSeats  Int      @default(0)
  carClass    String   @default("standard") /// standard | minivan
  priceKzt    Int
  status      String   @default("requested") /// requested | planned | driver | done | cancelled
  driverName  String?
  sign        String?
  address     String?
  guestName   String?
  guestPhone  String?
  paid        Boolean  @default(false)
  createdAt   DateTime @default(now())

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guest     Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
}

model CleaningTask {
  id          String    @id @default(cuid())
  accountId   String
  apartmentId String
  bookingId   String?
  assigneeId  String?
  date        DateTime
  fromTime    String    @default("12:00")
  toTime      String    @default("18:00")
  status      String    @default("assigned") /// assigned | enroute | progress | done
  checklist   Json? /// [{label, done}]
  report      String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignee  User?     @relation("CleaningAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
  @@index([assigneeId])
}

model Contractor {
  id        String   @id @default(cuid())
  accountId String
  name      String
  type      String /// plumb | elec | appl | furn | other
  phone     String?
  note      String?
  regular   Boolean  @default(false)
  createdAt DateTime @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  repairTasks RepairTask[]
}

model RepairTask {
  id           String    @id @default(cuid())
  accountId    String
  apartmentId  String
  title        String
  description  String?
  type         String    @default("other") /// plumb | elec | appl | furn | other
  priority     String    @default("medium") /// low | medium | high
  status       String    @default("open") /// open | progress | done
  assigneeId   String? /// мастер из команды
  contractorId String? /// или внешний подрядчик
  assigneeLabel String? /// подпись исполнителя, если нет ни мастера, ни подрядчика («Администратор»)
  date         DateTime
  accessMode   String    @default("code") /// code | keys | presence
  accessNote   String?
  timeWindow   String?
  costKzt      Int?
  paid         Boolean   @default(false)
  blockDays    Int? /// квартира закрыта на ремонт N дней
  report       String?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())

  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apartment  Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  assignee   User?            @relation("RepairAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contractor Contractor?      @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  estimates  RepairEstimate[]

  @@index([accountId, date])
  @@index([assigneeId])
}

/// Смета по ремонту: ждёт одобрения владельца/админа.
model RepairEstimate {
  id           String    @id @default(cuid())
  accountId    String
  repairTaskId String
  workKzt      Int
  partsKzt     Int
  items        String?
  byName       String?
  status       String    @default("pending") /// pending | approved | rejected
  decidedAt    DateTime?
  decidedById  String?
  createdAt    DateTime  @default(now())

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  repairTask RepairTask @relation(fields: [repairTaskId], references: [id], onDelete: Cascade)
}

/// Курс: сколько тенге стоит 1 единица валюты (например USD = 510).
model ExchangeRate {
  id        String   @id @default(cuid())
  accountId String
  code      String /// RUB | USD | EUR
  rateKzt   Float
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, code])
}

model CurrencySettings {
  id        String @id @default(cuid())
  accountId String @unique
  shown     Json /// ["KZT","RUB","USD","EUR"] — какие валюты показывать гостям
  roundMode String @default("nearest") /// nearest | up | none
  roundStep Json? /// {"RUB":10,"USD":1,"EUR":1}

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Редактируемые тексты сайта (кнопки, заголовки) по языкам. Нет записи — берётся текст по умолчанию.
model SiteText {
  id        String   @id @default(cuid())
  accountId String
  lang      String /// ru | en
  key       String /// например hero.title
  value     String
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, lang, key])
}

model Brand {
  id        String  @id @default(cuid())
  accountId String  @unique
  name      String
  short     String  @default("AS")
  taglineRu String  @default("")
  taglineEn String  @default("")
  logoUrl   String? /// загруженный логотип; пусто — рисованная заглушка-домик
  logoKey   String?
  colors    Json /// {"brand":"#0b3b4a","brand2":"#0f5566","accent":"#e0a526","accent2":"#c98a0c"}
  phone     String?
  telegram  String?
  whatsapp  String?
  email     String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// Журнал всех уведомлений (и отправленных в Telegram, и «только в лог», если бота нет).
model NotificationLog {
  id            String   @id @default(cuid())
  accountId     String
  event         String /// booking.requested, booking.confirmed, checkin.upcoming, …
  channel       String /// telegram | console
  recipientType String /// owner | admin | cleaning | master | guest
  recipientId   String?
  chatId        String?
  lang          String   @default("ru")
  text          String
  status        String /// sent | logged | failed | skipped
  error         String?
  dedupeKey     String?  @unique /// чтобы напоминание не ушло дважды
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  accountId         String
  bookingId         String?
  provider          String /// cloudpayments | paylink | manual
  providerPaymentId String?
  amountKzt         Int
  currency          String   @default("KZT")
  amount            Float
  status            String   @default("created") /// created | pending | succeeded | failed | refunded
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([accountId])
}
